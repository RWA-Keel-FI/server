# Copy to .env (never commit). CRE_ETH_PRIVATE_KEY: 64 hex chars, no 0x prefix. Needed by the CLI even for dry runs;
# for `--broadcast` it must hold Arc Testnet gas (USDC is the gas token on Arc; faucet: https://faucet.circle.com).
CRE_ETH_PRIVATE_KEY=
# Only if "finnhub" is added to `providers`:
FINNHUB_API_KEY_ENV=
